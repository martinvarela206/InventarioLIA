[mysqld]
# 1. Blindaje contra eliminaciones y modificaciones accidentales masivas por fuera de la aplicación
# Exige que toda sentencia UPDATE o DELETE incluya una cláusula WHERE con clave/índice o un LIMIT explícito.
sql_safe_updates = ON

# 2. Forzar comprobación estricta de claves foráneas
foreign_key_checks = ON

# 3. Modo SQL estricto para evitar truncamientos silenciosos o coerción de tipos inválidos
sql_mode = "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"

# 4. Deshabilitar carga de archivos locales para mitigar ataques de inyección remota
local_infile = 0

# 5. Auditoría forense permanente de operaciones DML y DDL
plugin_load_add = server_audit
server_audit = FORCE_PLUS_PERMANENT
server_audit_logging = ON
server_audit_events = CONNECT,QUERY_DML,QUERY_DDL
server_audit_output_type = FILE
server_audit_file_path = /var/log/mysql/audit.log
server_audit_file_rotate_size = 104857600
server_audit_file_rotations = 5
